# ==============================================================================
# Full Test Folder Local .gitignore
# ==============================================================================

# Compiled binaries and Visual Studio build artifacts
build/
*.exe
*.dll
*.pdb
*.ilk
*.exp
*.lib
*.vcxproj*

# Local heavy C++ SDKs (OpenCV & ONNX Runtime C++ downloads)
deps/

# Downloaded video test suite and temporary frames (large media files)
*.mp4
*.m4a
opt_verification_frame*.jpg

# Python cache & logs
__pycache__/
*.pyc
onnxruntime_win-x64-gpu-*
verify_optimizations.py