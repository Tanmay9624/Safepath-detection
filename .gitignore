# ==============================================================================
# SafePath AI - full_test/.gitignore
# Rules to keep repository lightweight, clean, and strictly under GitHub quotas
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Native C++ Compiled Binaries & Build Trees (>1 GB)
# ------------------------------------------------------------------------------
build/
bin/
Release/
Debug/
x64/
*.exe
*.dll
*.so
*.dylib
*.pdb
*.ilk
*.exp
*.lib
*.a
*.obj
*.o
*.vcxproj*
*.sln
CMakeCache.txt
CMakeFiles/
cmake_install.cmake

# ------------------------------------------------------------------------------
# 2. Heavy External Pre-compiled SDKs (>1.5 GB)
# ------------------------------------------------------------------------------
deps/
onnxruntime-win-x64-gpu-*/
onnxruntime_win-x64-gpu-*

# ------------------------------------------------------------------------------
# 3. Heavy Deep Learning Models & Weights (>150 MB, exceeds GitHub limits)
# ------------------------------------------------------------------------------
models/*.onnx
models/*.onnx.data
*.onnx
*.onnx.data
Android/app/src/main/assets/*.onnx
Android/app/src/main/assets/*.onnx.data

# ------------------------------------------------------------------------------
# 4. Heavy Video Test Datasets (Hundreds of MB)
# ------------------------------------------------------------------------------
docs/videos/
*.mp4
*.m4a
*.avi
*.mov
*.mkv
*.wmv

# ------------------------------------------------------------------------------
# 5. Android Studio, Gradle Caches & Mobile Binaries (>800 MB)
# ------------------------------------------------------------------------------
Android/.gradle/
Android/build/
Android/app/build/
Android/app/.cxx/
Android/local.properties
Android/.idea/
Android/*.iml
*.apk
*.aab
# Heavy pre-compiled native libraries in Android (avoid committing multi-hundred MB binaries)
Android/app/src/main/cpp/libs/
Android/app/src/main/cpp/sdk/native/bin/
Android/app/src/main/cpp/sdk/native/libs/
Android/app/src/main/cpp/sdk/native/staticlibs/
Android/app/src/main/cpp/sdk/native/3rdparty/libs/

# ------------------------------------------------------------------------------
# 6. Python Cache, Bytecode & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.log

# ------------------------------------------------------------------------------
# 7. Presentations & Binary Media Files
# ------------------------------------------------------------------------------
*.pptx
*.ppt
*.key
docs/create_presentation.py
create_presentation.py

# ------------------------------------------------------------------------------
# 8. Temporary Test Outputs (Preserve docs/images/ for documentation)
# ------------------------------------------------------------------------------
test/image_output/
opt_verification_frame*.jpg
test/opt_verification_frame*.jpg
# Ignore loose root images while strictly tracking curated docs images
*.jpg
!docs/images/*.jpg
!docs/images/**/*.jpg
*.png
!docs/images/*.png
!docs/images/**/*.png

# ------------------------------------------------------------------------------
# 9. IDE, OS & Editor Metadata
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store